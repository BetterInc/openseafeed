# /etc/openseafeed/denmark.env — config for openseafeed-connector@denmark
#
# Denmark = DMA (Danish Maritime Authority). The upstream address is granted
# per-user by DMA; the connector exits (code 2) with instructions if it is
# unset.

OSF_INGEST_URL=wss://ingest.openseafeed.org/v1/ingest

# Your feed key (get one from the control-plane dashboard — see docs/connectors.md).
OSF_FEED_KEY=osf_feed_replace_me

# The tcp://host:port DMA granted to you.
OSF_DENMARK_ADDR=tcp://replace-me:port

RUST_LOG=info
