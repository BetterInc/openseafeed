# Remote state on Scaleway Object Storage (S3-compatible).
#
# Copy to backend.tf and run `tofu init`. Create the bucket first (the same
# bucket as the Kapsule module is fine — the key below keeps them apart):
#   scw object bucket create name=openseafeed-tofu-state region=fr-par
#
# Auth uses the same Scaleway access/secret keys as the provider, passed as the
# AWS-compatible env vars:
#   export AWS_ACCESS_KEY_ID=$SCW_ACCESS_KEY
#   export AWS_SECRET_ACCESS_KEY=$SCW_SECRET_KEY
terraform {
  backend "s3" {
    bucket                      = "openseafeed-tofu-state"
    key                         = "instance/terraform.tfstate"
    region                      = "fr-par"
    endpoints                   = { s3 = "https://s3.fr-par.scw.cloud" }
    skip_credentials_validation = true
    skip_region_validation      = true
    skip_requesting_account_id  = true
    skip_s3_checksum            = true
  }
}
