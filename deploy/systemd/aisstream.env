# /etc/openseafeed/aisstream.env — config for openseafeed-connector@aisstream
#
# aisstream.io is a third-party aggregator. This connector needs your
# aisstream.io API key in addition to your OpenSeaFeed feed key.
#
# NOTE: contributing a third-party aggregator's feed is subject to that
# provider's terms — you are responsible for having the right to do so.

OSF_INGEST_URL=wss://ingest.openseafeed.com/v1/ingest

# Your OpenSeaFeed feed key (control-plane dashboard — see docs/connectors.md).
OSF_FEED_KEY=osf_feed_replace_me

# Your aisstream.io API key.
OSF_AISSTREAM_KEY=replace_me

RUST_LOG=info
