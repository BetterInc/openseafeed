# OpenSeaFeed local configuration.
#
# Copy to `.env` (gitignored — never commit it) and fill in what you use;
# docker compose loads it automatically. Everything has a working dev
# default except the per-provider secrets at the bottom.

# --- Platform --------------------------------------------------------------
RUST_LOG=info
# dev = accept any well-formed key; http = validate against the control plane
OSF_KEYS_MODE=dev
OSF_INTERNAL_TOKEN=dev-internal-token
OSF_SESSION_SECRET=dev-session-secret

# --- OAuth providers (control plane; leave empty to disable a provider) ----
OSF_GITHUB_CLIENT_ID=
OSF_GITHUB_CLIENT_SECRET=
OSF_GOOGLE_CLIENT_ID=
OSF_GOOGLE_CLIENT_SECRET=

# --- Feed connector keys ----------------------------------------------------
# One OUR-side feed key per connector (create real ones in the control-plane
# dashboard; any osf_feed_/osf_stn_ + 8 chars works in dev keys mode).
OSF_FEED_KEY_NORWAY=osf_feed_norwaydev
OSF_FEED_KEY_FINLAND=osf_feed_finlanddev
OSF_FEED_KEY_DENMARK=osf_feed_denmarkdev
OSF_FEED_KEY_AISSTREAM=osf_feed_aisstreamdev

# --- Upstream provider secrets ----------------------------------------------
# aisstream.io API key (from aisstream.io) — enables:
#   docker compose --profile aisstream up -d
OSF_AISSTREAM_KEY=

# Denmark LIVE stream: the tcp://host:port endpoint DMA granted you — enables:
#   docker compose --profile denmark up -d
OSF_DENMARK_ADDR=

# Denmark HISTORY importer (no key needed; public daily dumps) — enables:
#   docker compose --profile dma-history up -d
# Days back to import on first run (dumps lag ~3 days; each file is 500-900MB):
OSF_DMA_BACKFILL_DAYS=7
OSF_DMA_POLL_SECS=3600
OSF_DMA_ROWS_PER_SEC=20000
