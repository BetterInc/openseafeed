# OpenSeaFeed production configuration (single-box deploy).
#
# On the server:
#   cp .env.production.example .env    # then fill EVERY "CHANGE-ME" below
#   chmod 600 .env                     # it holds every secret the stack has
#   docker compose up -d --build
#
# Never commit the filled-in file. Runbook: docs/production.md.

# --- Compose ---------------------------------------------------------------
# Both files, always: the overlay is what puts Caddy in front and takes the
# host ports away. With this set, plain `docker compose <cmd>` is enough — no
# -f flags to remember (and no half-configured stack from forgetting them).
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# Connector profiles that are part of every command, so `docker compose down`
# never orphans a connector. feeds = Norway + Finland (public, no secrets);
# aisstream = the third-party aggregator; dma-history = Denmark daily dumps.
# Add `denmark` once DMA grants you a live upstream address.
COMPOSE_PROFILES=feeds,aisstream,dma-history

RUST_LOG=info

# --- Platform --------------------------------------------------------------
# http = validate every API/feed key against the control plane. Never `dev`
# here: dev accepts any well-formed key.
OSF_KEYS_MODE=http
# Public https:// base URL of the control plane. OAuth redirect URIs are built
# from it, so it must match the callbacks registered with GitHub/Google.
OSF_PUBLIC_URL=https://api.openseafeed.com
# Service-to-service auth (ingest/fanout -> control, fanout -> snapshotter).
# openssl rand -hex 32
OSF_INTERNAL_TOKEN=CHANGE-ME-random-32-bytes-hex
# Origins serving your own live map: a keyless viewer arriving from one of
# these gets the whole world and the freshest snapshot, where an anonymous
# third-party client keeps the free tier's area cap and 10-minute delay. Set
# this if you serve the map from a domain other than stream.openseafeed.com.
# OSF_VIEWER_ORIGINS=https://stream.example.com
# Signs the control-plane session cookies; rotating it logs everyone out.
OSF_SESSION_SECRET=CHANGE-ME-random-32-bytes-hex

# --- History retention (archiver) ------------------------------------------
# Days on the local hot disk before parts move to the Wasabi cold tier.
OSF_HOT_DAYS=7
# Total retention: 1825 days = 5 years, then the parts are deleted.
# NOTE both are baked into the table at creation — changing them later needs a
# manual ALTER TABLE ... MODIFY TTL (docs/deploy.md, "History storage").
OSF_RETAIN_DAYS=1825

# --- OAuth (control plane) -------------------------------------------------
# GitHub OAuth app; callback https://api.<your-domain>/auth/github/callback
OSF_GITHUB_CLIENT_ID=CHANGE-ME
OSF_GITHUB_CLIENT_SECRET=CHANGE-ME
# Google OAuth client; callback https://api.<your-domain>/auth/google/callback
OSF_GOOGLE_CLIENT_ID=CHANGE-ME
OSF_GOOGLE_CLIENT_SECRET=CHANGE-ME

# --- ClickHouse ------------------------------------------------------------
# Password for the `osf` user; used by the server, the archiver and the backup
# script. Compose refuses to start without it. openssl rand -base64 24
OSF_CLICKHOUSE_PASSWORD=CHANGE-ME-strong-password

# --- Wasabi object storage -------------------------------------------------
# S3 endpoint for your Wasabi region (eu-central-2 = Amsterdam).
OSF_WASABI_ENDPOINT=https://s3.eu-central-2.wasabisys.com
# Region, used by the aws-cli calls in scripts/backup.sh.
OSF_WASABI_REGION=eu-central-2
# Bucket holding the ClickHouse COLD TIER — live data, queried in place.
OSF_WASABI_BUCKET=openseafeed-ais-cold
# Bucket holding BACKUPS. Must be a different bucket: a backup inside the live
# data's bucket dies with it.
OSF_BACKUP_BUCKET=openseafeed-backup
# Wasabi access key pair with read/write on both buckets above.
OSF_WASABI_ACCESS_KEY=CHANGE-ME
OSF_WASABI_SECRET_KEY=CHANGE-ME
# Nightly backups to keep before the oldest are pruned (scripts/backup.sh).
OSF_BACKUP_KEEP=14

# --- Feed connector keys ---------------------------------------------------
# One OSF-side feed key per connector. In production these must be REAL keys
# created in the control-plane dashboard (OSF_KEYS_MODE=http validates them),
# one per feed so a leak can be revoked without taking the others down.
OSF_FEED_KEY_NORWAY=CHANGE-ME-osf_feed_...
OSF_FEED_KEY_FINLAND=CHANGE-ME-osf_feed_...
OSF_FEED_KEY_AISSTREAM=CHANGE-ME-osf_feed_...
# Only needed with the `denmark` profile:
#OSF_FEED_KEY_DENMARK=CHANGE-ME-osf_feed_...

# --- Upstream provider secrets ---------------------------------------------
# aisstream.io API key. Rotate it before first use if it has ever been shared
# in plaintext (docs/production.md, Phase 0). Contributing a third-party
# aggregator's data is subject to that provider's terms.
OSF_AISSTREAM_KEY=CHANGE-ME
# Denmark LIVE stream: the tcp://host:port endpoint DMA granted you. Also add
# `denmark` to COMPOSE_PROFILES above.
#OSF_DENMARK_ADDR=

# --- Denmark history importer (profile dma-history) ------------------------
# Days back to import; DMA publishes each day ~3 days late, 500-900 MB/file.
OSF_DMA_BACKFILL_DAYS=7
# 0 = unlimited files per poll, i.e. fill the whole window (production value;
# local dev uses 1). Expect heavy disk + network on the first runs.
OSF_DMA_MAX_FILES=0
OSF_DMA_POLL_SECS=3600
# Insert rate ceiling, so a backfill cannot starve the live archiver.
OSF_DMA_ROWS_PER_SEC=20000
