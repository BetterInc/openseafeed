# /etc/openseafeed/finland.env — config for openseafeed-connector@finland
#
# Finland = Digitraffic's public MQTT/WSS feed. No upstream credentials needed.

OSF_INGEST_URL=wss://ingest.openseafeed.com/v1/ingest
# LAN / same-host alternatives:
#   OSF_INGEST_URL=tcp://ingest.internal:10111
#   OSF_INGEST_URL=udp://127.0.0.1:10110   # dev/LAN only, unauthenticated

# Your feed key (get one from the control-plane dashboard — see docs/connectors.md).
OSF_FEED_KEY=osf_feed_replace_me

RUST_LOG=info
